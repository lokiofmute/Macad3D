{
    // Macad3D build tasks. All tasks go through ScriptConsole.cmd so they behave
    // exactly like the interactive script console described in Readme.md.
    // Ctrl+Shift+B runs the default build task (Build Debug).
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
    },
    "tasks": [
        {
            "label": "Macad: Restore",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "restore"],
            "problemMatcher": []
        },
        {
            "label": "Macad: Build Debug",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "build", "debug"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Macad: Build Release",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "build", "release"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Macad: Build All",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "build", "all"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Macad: Rebuild All (clean)",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "build", "all", "/clean"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Macad: Test All (Release)",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "test", "all"],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "Macad: Test All (Debug)",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${workspaceFolder}\\ScriptConsole.cmd", "test", "all", "/debug"],
            "problemMatcher": "$msCompile",
            "group": "test"
        }
    ]
}
